Algoritmo PiramideNumeros
		Definir n, fila, col Como Entero
		
		Escribir "Ingresa el número de líneas (n): "
		Leer n
		
		Para fila <- 1 Hasta n Con Paso 1 Hacer
			Para col <- 1 Hasta fila Con Paso 1 Hacer
				Escribir Sin Saltar col, " "
			FinPara
			Escribir "" 
		FinPara

FinAlgoritmo
